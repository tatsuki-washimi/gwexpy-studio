{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gwexpy.org/studio/schemas/project-v2.schema.json",
  "title": "GWexpy Studio Project v2",
  "description": "Strict data-only project state for the headless Studio prototype.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project_id", "created", "modified", "compatibility", "sources", "objects", "operations", "executions", "plots", "ui_state"],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "project_id": {"$ref": "#/$defs/projectId"},
    "created": {
      "type": "string",
      "format": "date-time"
    },
    "modified": {
      "type": "string",
      "format": "date-time"
    },
    "compatibility": {"$ref": "#/$defs/compatibility"},
    "sources": {
      "type": "array",
      "items": {"$ref": "#/$defs/dataSourceRef"},
      "uniqueItems": true
    },
    "objects": {
      "type": "array",
      "items": {"$ref": "#/$defs/dataObjectRef"},
      "uniqueItems": true
    },
    "operations": {
      "type": "array",
      "items": {"$ref": "#/$defs/operation"},
      "uniqueItems": true
    },
    "executions": {
      "type": "array",
      "items": {"$ref": "#/$defs/executionRecord"},
      "uniqueItems": true
    },
    "plots": {
      "type": "array",
      "items": {"$ref": "#/$defs/plotSpec"},
      "uniqueItems": true
    },
    "ui_state": {"$ref": "#/$defs/jsonObject"},
    "activities": {
      "type": "array",
      "items": {"$ref": "#/$defs/activityRecord"}
    }
  },
  "$defs": {
    "projectId": {
      "type": "string",
      "minLength": 1
    },
    "sourceId": {
      "type": "string",
      "pattern": "^src-[1-9][0-9]*$"
    },
    "objectId": {
      "type": "string",
      "pattern": "^obj-[1-9][0-9]*$"
    },
    "operationId": {
      "type": "string",
      "pattern": "^op-[1-9][0-9]*$"
    },
    "executionId": {
      "type": "string",
      "pattern": "^exec-[1-9][0-9]*$"
    },
    "plotId": {
      "type": "string",
      "pattern": "^plot-.+$"
    },
    "jsonPrimitive": {
      "type": ["string", "number", "integer", "boolean", "null"]
    },
    "jsonValue": {
      "anyOf": [
        {"$ref": "#/$defs/jsonPrimitive"},
        {
          "type": "array",
          "items": {"$ref": "#/$defs/jsonValue"}
        },
        {"$ref": "#/$defs/jsonObject"}
      ]
    },
    "jsonObject": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/jsonValue"}
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["studio", "gwexpy"],
      "properties": {
        "studio": {
          "type": "string",
          "minLength": 1
        },
        "gwexpy": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "sourceFormat": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "dataSourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "uri", "format", "size_bytes", "mtime"],
      "properties": {
        "source_id": {"$ref": "#/$defs/sourceId"},
        "uri": {
          "type": "string",
          "pattern": "^(?:/|[A-Za-z]:[\\\\/])",
          "minLength": 1
        },
        "format": {"$ref": "#/$defs/sourceFormat"},
        "size_bytes": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "mtime": {
          "type": ["number", "null"],
          "minimum": 0
        }
      }
    },
    "quantity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "unit"],
      "properties": {
        "value": {"type": "number"},
        "unit": {"type": "string"}
      }
    },
    "dataObjectCommon": {
      "type": "object",
      "additionalProperties": false,
      "required": ["object_id", "kind", "shape", "dtype", "unit", "name", "channel", "axes", "produced_by"],
      "properties": {
        "object_id": {"$ref": "#/$defs/objectId"},
        "kind": {
          "enum": ["TimeSeries", "TimeSeriesDict", "TimeSeriesList", "TimeSeriesMatrix", "FrequencySeries", "FrequencySeriesDict", "FrequencySeriesList", "FrequencySeriesMatrix", "Spectrogram", "SpectrogramDict", "SpectrogramList", "SpectrogramMatrix"]
        },
        "shape": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "dtype": {
          "type": ["string", "null"]
        },
        "unit": {
          "type": ["string", "null"]
        },
        "name": {
          "type": ["string", "null"]
        },
        "channel": {
          "type": ["string", "null"]
        },
        "axes": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "t0": {"$ref": "#/$defs/quantity"},
            "dt": {"$ref": "#/$defs/quantity"},
            "f0": {"$ref": "#/$defs/quantity"},
            "df": {"$ref": "#/$defs/quantity"},
            "time": {"$ref": "#/$defs/explicitAxis"},
            "frequency": {"$ref": "#/$defs/explicitAxis"}
          }
        },
        "produced_by": {
          "anyOf": [
            {"$ref": "#/$defs/operationId"},
            {"type": "null"}
          ]
        },
        "metadata": {"$ref": "#/$defs/jsonObject"},
        "members": {
          "type": "array",
          "items": {"$ref": "#/$defs/memberRef"}
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "enum": ["TimeSeries", "FrequencySeries", "TimeSeriesDict", "TimeSeriesList", "FrequencySeriesDict", "FrequencySeriesList", "SpectrogramDict", "SpectrogramList"]
              }
            }
          },
          "then": {
            "properties": {
              "shape": {
                "minItems": 1,
                "maxItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": ["Spectrogram"]
              }
            }
          },
          "then": {
            "properties": {
              "shape": {
                "minItems": 2,
                "maxItems": 2
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": ["TimeSeriesMatrix", "FrequencySeriesMatrix"]
              }
            }
          },
          "then": {
            "properties": {
              "shape": {
                "minItems": 3,
                "maxItems": 3
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": ["SpectrogramMatrix"]
              }
            }
          },
          "then": {
            "properties": {
              "shape": {
                "minItems": 3,
                "maxItems": 4
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": ["TimeSeries", "FrequencySeries", "Spectrogram"]
              }
            }
          },
          "then": {
            "properties": {
              "dtype": {"type": "string"},
              "unit": {"type": "string"}
            }
          }
        }
      ]
    },
    "dataObjectRef": {"$ref": "#/$defs/dataObjectCommon"},
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op_id", "operation_id", "operation_schema", "inputs", "params", "outputs"],
      "properties": {
        "op_id": {"$ref": "#/$defs/operationId"},
        "operation_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]*$",
          "minLength": 1
        },
        "operation_schema": {
          "type": "integer",
          "const": 1
        },
        "inputs": {
          "type": "object",
          "additionalProperties": {"$ref": "#/$defs/objectId"}
        },
        "params": {"$ref": "#/$defs/jsonObject"},
        "outputs": {
          "type": "array",
          "items": {"$ref": "#/$defs/objectId"},
          "minItems": 1,
          "uniqueItems": true
        }
      }
    },
    "executionRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["execution_id", "op_id", "started_at", "duration_s", "status", "warnings", "error", "environment"],
      "properties": {
        "execution_id": {"$ref": "#/$defs/executionId"},
        "op_id": {"$ref": "#/$defs/operationId"},
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "duration_s": {
          "type": "number",
          "minimum": 0
        },
        "status": {
          "type": "string",
          "enum": ["pending", "running", "succeeded", "failed"]
        },
        "warnings": {
          "type": "array",
          "items": {"type": "string"}
        },
        "error": {
          "anyOf": [
            {"$ref": "#/$defs/jsonObject"},
            {"type": "null"}
          ]
        },
        "environment": {
          "type": "object",
          "additionalProperties": {"type": "string"}
        },
        "details": {"$ref": "#/$defs/jsonObject"}
      }
    },
    "plotSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plot_id", "kind", "object_ids", "xscale", "yscale", "xlim", "ylim", "title", "xlabel", "ylabel", "legend", "styles"],
      "properties": {
        "plot_id": {"$ref": "#/$defs/plotId"},
        "kind": {
          "enum": ["line", "spectrogram", "bode"]
        },
        "object_ids": {
          "type": "array",
          "items": {"$ref": "#/$defs/objectId"},
          "minItems": 1,
          "uniqueItems": true
        },
        "xscale": {
          "type": "string",
          "enum": ["linear", "log"]
        },
        "yscale": {
          "type": "string",
          "enum": ["linear", "log"]
        },
        "xlim": {"$ref": "#/$defs/limit"},
        "ylim": {"$ref": "#/$defs/limit"},
        "title": {
          "type": ["string", "null"]
        },
        "xlabel": {
          "type": ["string", "null"]
        },
        "ylabel": {
          "type": ["string", "null"]
        },
        "legend": {"type": "boolean"},
        "styles": {"$ref": "#/$defs/jsonObject"},
        "component": {
          "enum": ["real", "imag", "abs", "phase"]
        },
        "magnitude_scale": {
          "enum": ["db", "linear"]
        },
        "db_reference": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "display_unit": {
          "type": ["string", "null"]
        },
        "phase_unwrap": {"type": "boolean"},
        "selectors": {
          "type": "object",
          "additionalProperties": {"$ref": "#/$defs/memberSelector"}
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {"const": "spectrogram"}
            }
          },
          "then": {
            "properties": {
              "object_ids": {
                "maxItems": 1
              }
            }
          }
        }
      ]
    },
    "limit": {
      "anyOf": [
        {"type": "null"},
        {
          "type": "array",
          "prefixItems": [
            {"type": "number"},
            {"type": "number"}
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        }
      ]
    },
    "explicitAxis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "unit", "length", "dtype"],
      "properties": {
        "kind": {"const": "explicit"},
        "unit": {"type": "string"},
        "length": {
          "type": "integer",
          "minimum": 0
        },
        "dtype": {"type": "string"}
      }
    },
    "memberRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selector", "label", "kind", "shape", "dtype", "unit", "name", "channel", "axes"],
      "properties": {
        "kind": {
          "enum": ["TimeSeries", "FrequencySeries", "Spectrogram"]
        },
        "shape": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "dtype": {
          "type": ["string", "null"]
        },
        "unit": {
          "type": ["string", "null"]
        },
        "name": {
          "type": ["string", "null"]
        },
        "channel": {
          "type": ["string", "null"]
        },
        "axes": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "t0": {"$ref": "#/$defs/quantity"},
            "dt": {"$ref": "#/$defs/quantity"},
            "f0": {"$ref": "#/$defs/quantity"},
            "df": {"$ref": "#/$defs/quantity"},
            "time": {"$ref": "#/$defs/explicitAxis"},
            "frequency": {"$ref": "#/$defs/explicitAxis"}
          }
        },
        "metadata": {"$ref": "#/$defs/jsonObject"},
        "label": {"type": "string"},
        "selector": {"$ref": "#/$defs/memberSelector"}
      }
    },
    "activityRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["activity_id", "action", "started_at", "status"],
      "properties": {
        "activity_id": {
          "type": "string",
          "pattern": "^activity-[1-9][0-9]*$"
        },
        "action": {"type": "string"},
        "started_at": {"type": "string"},
        "status": {"type": "string"},
        "object_id": {
          "type": ["string", "null"]
        },
        "target": {
          "type": ["string", "null"]
        },
        "duration_s": {
          "type": "number",
          "minimum": 0
        },
        "details": {"$ref": "#/$defs/jsonObject"},
        "warnings": {
          "type": "array",
          "items": {"type": "string"}
        },
        "error": {
          "anyOf": [
            {"$ref": "#/$defs/jsonObject"},
            {"type": "null"}
          ]
        }
      }
    },
    "memberSelector": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["key"],
          "properties": {
            "key": {
              "type": ["string", "integer"]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["index"],
          "properties": {
            "index": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["batch"],
          "properties": {
            "batch": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["row", "col"],
          "properties": {
            "row": {
              "type": "integer",
              "minimum": 0
            },
            "col": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      ]
    }
  }
}
